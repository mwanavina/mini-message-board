<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Mini Message Board</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="container narrow">
      <a class="back-link" href="/">&larr; Back to board</a>
      <article class="message message-detail">
        <p class="eyebrow">Message details</p>
        <h1><%= message.user %></h1>
        <time datetime="<%= message.added.toISOString() %>">
          <%= message.added.toLocaleString() %>
        </time>
        <p class="detail-text"><%= message.text %></p>
      </article>
    </main>
  </body>
</html>