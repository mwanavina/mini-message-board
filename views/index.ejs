<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="container">
      <header class="page-header">
        <div>
          <p class="eyebrow">Community board</p>
          <h1><%= title %></h1>
        </div>
        <a class="button" href="/new">New message</a>
      </header>

      <section class="messages" aria-label="Messages">
        <% messages.forEach((message) => { %>
          <article class="message">
            <div class="message-header">
              <h2><%= message.user %></h2>
              <time datetime="<%= message.added.toISOString() %>">
                <%= message.added.toLocaleString() %>
              </time>
            </div>
            <p><%= message.text %></p>
            <a class="message-link" href="/message/<%= message.id %>">Open message</a>
          </article>
        <% }) %>
      </section>
    </main>
  </body>
</html>